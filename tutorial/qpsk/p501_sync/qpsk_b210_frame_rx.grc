    bus_source: false
    bus_structure: null
    coordinate: [8, 430]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: raise it until the received spectrum is clearly above the noise; lower
      it if the constellation is squashed
    gui_hint: 0,0,1,4
    label: B210 RX gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '76'
    value: '45'
    widget: counter_slider
  states:
