options:
  parameters:
    author: p501_fft_example
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'The B210 receives the frames (m-sequence preamble + PRBS-15 payload)
      of the P501''s FPGA transmitter at 915 MHz and decodes them: constellation,
      spectrum, frames found and bit error rate of the payload.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: qpsk_b210_frame_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'B210 receiver: the frames of the P501''s FPGA transmitter, decoded with
      GNU Radio'
    window_size: (1100, 800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    state: enabled

blocks:
- name: bw_div
  id: variable_qtgui_range
  parameters:
    comment: wide (small N) pulls in fast and is noisy; narrow (large N) is quieter
      but may not pull in
    gui_hint: 1,0,1,4
    label: 'Loop bandwidth: 2 pi / N (FLL, timing, Costas)'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '50'
    step: '10'
    stop: '1600'
    value: '400'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 140]
    state: enabled
- name: const_dqpsk
  id: variable
  parameters:
    comment: 'differential QPSK: rotation-proof, the same as the FPGA'
    value: digital.constellation_dqpsk().base()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 280]
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: root-raised-cosine roll-off
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 180]
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: carrier; check the rules where you are before transmitting
    value: 915e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 230]
    state: enabled
- name: nfilts
  id: variable
  parameters:
    comment: arms of the polyphase clock sync
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 380]
    state: enabled
- name: payload_syms
  id: variable
  parameters:
    comment: 'payload symbols per frame: the same as the P501''s start_frames(payload=...)'
    value: '960'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 330]
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.root_raised_cosine(nfilts, nfilts*sps, 1.0, excess_bw, 11*int(sps*nfilts))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 430]
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: raise it until the received spectrum is clearly above the noise; lower
      it if the constellation is squashed
    gui_hint: 0,0,1,4
    label: B210 RX gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '76'
    value: '45'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 60]
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: '3.84 MSPS: the P501''s sample rate; 960 ksym/s at 4 samples per symbol'
    value: '3840000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 80]
    state: enabled
