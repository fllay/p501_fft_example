options:
  parameters:
    author: p501_fft_example
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: The B210 transmits PRBS-15 differential QPSK at 915 MHz, 3.84 MSPS;
      the P501 notebook receives it with its FPGA receiver.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: qpsk_b210_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'B210 transmitter: PRBS-15 DQPSK for the P501''s FPGA receiver'
    window_size: (1100, 800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    state: enabled

blocks:
- name: const_dqpsk
  id: variable
  parameters:
    comment: 'differential QPSK: rotation-proof, the same as the FPGA'
    value: digital.constellation_dqpsk().base()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 280]
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: root-raised-cosine roll-off
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 180]
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: carrier; check the rules where you are before transmitting
    value: 915e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 230]
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: '3.84 MSPS: the P501''s sample rate; 960 ksym/s at 4 samples per symbol'
    value: '3840000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 80]
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 130]
    state: enabled
- name: tx_amp
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,4
    label: TX digital amplitude
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '0.5'
    value: '0.25'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 180]
    state: enabled
- name: tx_gain
  id: variable_qtgui_range
  parameters:
    comment: 'very low power: antennas a few centimetres apart; 80 dB decodes cleanly
      at the P501, 70 is marginal, 60 does not lock'
    gui_hint: 0,1,1,3
    label: B210 TX gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '80'
    value: '80'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 100]
    state: enabled
- name: tx_on
  id: variable_qtgui_chooser
  parameters:
    comment: OFF at start. Switch ON when the P501 notebook is ready to receive.
    gui_hint: 0,0,1,1
    label: Transmit (B210 TX/RX port)
    label0: 'OFF'
    label1: 'ON'
    label2: ''
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '2'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: int
    value: '0'
    widget: radio_buttons
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 20]
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: tx_amp*tx_on
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 300]
    state: enabled
- name: digital_constellation_modulator_0
  id: digital_constellation_modulator
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    constellation: const_dqpsk
    differential: 'True'
    excess_bw: excess_bw
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    truncate: 'False'
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 290]
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"PRBS-15 (x^15 + x^14 + 1, seed 0x7FFF) as packed bytes, repeated:\
      \ 8 periods = 262136 bits = 32767 whole bytes, so the repeat is seamless.\n\
      \    The bits are the ones that the FPGA transmitter (qpsk_tx.v) sends and that\
      \ the FPGA receiver's self-synchronising checker expects.\"\"\"\n\n    def __init__(self):\n\
      \        gr.sync_block.__init__(self, name=\"PRBS-15 bytes\", in_sig=None, out_sig=[np.uint8])\n\
      \        s, bits = 0x7FFF, np.zeros(32767, dtype=np.uint8)\n        for i in\
      \ range(32767):\n            bits[i] = (s >> 14) & 1\n            s = ((s <<\
      \ 1) & 0x7FFF) | (((s >> 14) ^ (s >> 13)) & 1)\n        self.data = np.packbits(np.tile(bits,\
      \ 8))\n        self.pos = 0\n\n    def work(self, input_items, output_items):\n\
      \        out = output_items[0]\n        n = len(out)\n        idx = (self.pos\
      \ + np.arange(n)) % len(self.data)\n        out[:] = self.data[idx]\n      \
      \  self.pos = (self.pos + n) % len(self.data)\n        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''PRBS-15 bytes'', ''blk'', [], [], [(''0'', ''byte'', 1)], "PRBS-15
      (x^15 + x^14 + 1, seed 0x7FFF) as packed bytes, repeated: 8 periods = 262136
      bits = 32767 whole bytes, so the repeat is seamless.\n    The bits are the ones
      that the FPGA transmitter (qpsk_tx.v) sends and that the FPGA receiver''s self-synchronising
      checker expects.", [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 300]
    state: enabled
