options:
  parameters:
    author: p501_fft_example
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'The B210 receives the P501''s FPGA QPSK transmitter (PRBS-15) at
      915 MHz and decodes it: constellation, spectrum and bit error rate.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: qpsk_b210_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'B210 receiver: the P501''s FPGA transmitter, decoded with GNU Radio'
    window_size: (1100, 800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: bw_div
  id: variable_qtgui_range
  parameters:
    comment: wide (small N) pulls in fast and is noisy; narrow (large N) is quieter
      but may not pull in
    gui_hint: 1,0,1,4
    label: 'Loop bandwidth: 2 pi / N (FLL, timing, Costas)'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '50'
    step: '10'
    stop: '1600'
    value: '400'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 140]
    rotation: 0
    state: enabled
- name: const_dqpsk
  id: variable
  parameters:
    comment: 'differential QPSK: rotation-proof, the same as the FPGA'
    value: digital.constellation_dqpsk().base()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 280]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: root-raised-cosine roll-off
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 180]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: carrier; check the rules where you are before transmitting
    value: 915e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 230]
    rotation: 0
    state: enabled
- name: nfilts
