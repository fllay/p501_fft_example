- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Self-synchronising PRBS-15 checker, the same rule as the FPGA's:\
      \ a[n] = a[n-15] ^ a[n-14]; a mismatch is counted when the received bit differs\
      \ from\n    the prediction, and an isolated bit error gives 3 mismatches. Input:\
      \ one bit per byte. Output: the bit error rate over about the last second\n\
      \    (mismatches / 3 / bits, exponentially weighted), one value per input bit;\
      \ 0.17 means 'not locked' (random bits). A stream that is not half ones (for\
      \ example\n    stuck at 0, which also satisfies the PRBS rule) is reported as\
      \ 0.5.\"\"\"\n\n    def __init__(self, window_bits=1920000):\n        gr.sync_block.__init__(self,\
      \ name=\"PRBS-15 BER\", in_sig=[np.uint8], out_sig=[np.float32])\n        self.window\
      \ = float(window_bits)\n        self.hist = np.zeros(15, dtype=np.uint8)\n \
      \       self.filled = 0\n        self.m = 0.0\n        self.n = 0.0\n      \
      \  self.o = 0.0\n        self.ber = 0.5\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0] & 1\n        a = np.concatenate([self.hist, x])\n\
      \        if self.filled >= 15:\n            pred = a[:-15] ^ a[1:-14]\n    \
      \        mism = float(np.count_nonzero(a[15:] != pred))\n            k = np.exp(-len(x)\
      \ / self.window)\n            self.m = self.m * k + mism\n            self.n\
      \ = self.n * k + len(x)\n            self.o = self.o * k + float(np.count_nonzero(x))\n\
      \            self.ber = 0.5 if abs(self.o / self.n - 0.5) > 0.15 else self.m\
      \ / 3.0 / self.n\n        self.filled += len(x)\n        self.hist = a[-15:].copy()\n\
      \        output_items[0][:] = self.ber\n        return len(x)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    window_bits: '480000'
  states:
    _io_cache: '(''PRBS-15 BER'', ''blk'', [(''window_bits'', ''1920000'')], [(''0'',
      ''byte'', 1)], [(''0'', ''float'', 1)], "Self-synchronising PRBS-15 checker,
      the same rule as the FPGA''s: a[n] = a[n-15] ^ a[n-14]; a mismatch is counted
      when the received bit differs from\n    the prediction, and an isolated bit
      error gives 3 mismatches. Input: one bit per byte. Output: the bit error rate
      over about the last second\n    (mismatches / 3 / bits, exponentially weighted),
      one value per input bit; 0.17 means ''not locked'' (random bits). A stream that
      is not half ones (for example\n    stuck at 0, which also satisfies the PRBS
      rule) is reported as 0.5.", [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1060, 420]
    rotation: 0
    state: enabled
