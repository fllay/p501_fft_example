options:
  parameters:
    author: p501_fft_example
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'The B210 receives the OFDM frames of the P501 (or of ofdm_b210_frame_tx.grc) at 850 MHz, 3.84 MS/s and decodes them with separate blocks: S&C metric, frame detector, carrier corrections, FFT, channel estimate, equalizer, slicer, error counter; one plot tab per stage.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ofdm_b210_frame_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'B210 receiver: OFDM frames (Schmidl-Cox sync, 16-QAM data), block by block'
    window_size: (1280, 900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- parameters:
    value: '3840000'
    comment: '3.84 MS/s: the sample rate of the P501 and of the OFDM frames; N = 64 subcarriers of 60 kHz'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 100
    rotation: 0
    state: enabled
  name: samp_rate
  id: variable
- parameters:
    value: 850e6
    comment: 'carrier: the same as the transmitter''s (the P501 notebook P501_OFDM_Live or ofdm_b210_frame_tx.grc); check the rules where you are before transmitting'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 160
    rotation: 0
    state: enabled
  name: freq
  id: variable
- parameters:
    value: '"ofdm_b210_capture.c64"'
    comment: a recording of the B210 samples (complex float, 3.84 MS/s) for the File Source (disabled by default) instead of the B210
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 220
    rotation: 0
    state: enabled
  name: capture_file
  id: variable
- parameters:
    num_tabs: '6'
    label0: 1 Received signal
    label1: 2 Frame detection (Schmidl-Cox)
    label2: 3 Frame and carrier correction
    label3: 4 FFT
    label4: 5 Channel estimate
    label5: 6 Equalizer and decisions
    gui_hint: 2,0,1,6
    comment: one tab per stage of the receiver
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 280
    rotation: 0
    state: enabled
  name: tabs
  id: qtgui_tab_widget
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: raise it until the received spectrum is clearly above the noise and the constellation is clean; lower it if the samples clip
    gui_hint: 0,0,1,3
    label: B210 RX gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '76'
    value: '45'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 340
    rotation: 0
    state: enabled
- name: threshold
  id: variable_qtgui_range
  parameters:
    comment: 'a frame is found when M = |S|^2 / (Ea Eb) reaches this value (the P501 FPGA uses 0.65): lower finds weaker frames and gives more false detections, which the T1/T2 check throws away'
    gui_hint: 0,3,1,3
    label: S&C detection threshold (metric M)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.3'
    step: '0.01'
    stop: '0.95'
    value: '0.65'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 420
    rotation: 0
    state: enabled
- name: decode_n
  id: variable_qtgui_range
  parameters:
    comment: 'the transmitter sends the same frame 1000 times per second: the Python blocks of this flowgraph cannot decode all of them in real time, so only 1 in N is passed on (8: 125 frames per second, 132 thousand symbols per second)'
    gui_hint: 1,0,1,3
    label: decode 1 frame in N
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '1'
    step: '1'
    stop: '40'
    value: '8'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 500
    rotation: 0
    state: enabled
- name: smooth
  id: variable_qtgui_range
  parameters:
    comment: 'the common gain and the slope found from the 4 pilots are averaged over this many symbols (centred): less noise, slower tracking'
    gui_hint: 1,3,1,3
    label: pilot smoothing (symbols)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '1'
    step: '2'
    stop: '9'
    value: '5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 580
    rotation: 0
    state: enabled
