- parameters:
    threshold: threshold
    back: '6'
    skip: decode_n - 1
    _source_code: "\"\"\"Schmidl-and-Cox frame detector. Inputs: the received samples x, the S&C metric M = |S|^2 / (Ea Eb) and the sum S of 32 products x[n] conj(x[n-32]) (all three aligned: the window ends at sample n).\nWhen M reaches `threshold` the next 72 windows are collected, the plateau (the windows with M >= 29/32 of the largest) is found and the middle of it gives the start of the S&C symbol: s0 = (window start) + (first + last + 1) // 2 - 8.\nOnly 1 frame in `skip + 1` is passed on (the transmitter repeats the same frame every 3840 samples; the python blocks behind could not follow 1000 frames per second in real time): after a frame the search starts again `skip` frames later.\nThe output is the frame as 3760 samples (47 symbols of 80: S&C, T1, T2 and 44 data symbols; the idle slot is dropped) starting `back` samples before s0 (the FFT windows then start inside the cyclic prefix: a timing error\nof up to `back` samples is harmless). Two tags are put on the first sample: `cfo`\
      \ (the coarse carrier offset in rad/sample = arg(sum of S over the plateau) / 32) and `gain` (1 / rms of the first 240 samples).\"\"\"\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFRAME = 3760        # 47 symbols of 80 samples\n\n\nclass blk(gr.basic_block):\n    def __init__(self, threshold=0.65, back=6, skip=3):\n        gr.basic_block.__init__(self, name=\"S&C frame detector\", in_sig=[np.complex64, np.float32, np.complex64], out_sig=[np.complex64])\n        self.threshold, self.back, self.skip = threshold, back, skip\n        self.x = np.zeros(0, np.complex64); self.M = np.zeros(0, np.float32); self.S = np.zeros(0, np.complex64)\n        self.base = 0                 # absolute index of x[0]\n        self.scan = 0                 # absolute index where the search for the next frame goes on\n        self.total = 0                # absolute index of the next input sample\n        self.skip_until = 0           # absolute index: input before it is dropped (the frames\
      \ that are skipped)\n        self.queue = []               # (frame, cfo, gain)\n        self.cur = None; self.pos = 0\n        self.frames = 0\n\n    def forecast(self, noutput_items, ninputs):\n        return [1] * ninputs\n\n    def _trim(self, keep_from):\n        k = int(min(max(keep_from, 0), len(self.x)))\n        if k:\n            self.x, self.M, self.S = self.x[k:], self.M[k:], self.S[k:]; self.base += k\n\n    def _search(self):\n        while True:\n            lo = max(self.scan - self.base, 0)\n            idx = np.nonzero(self.M[lo:] >= self.threshold)[0]\n            if len(idx) == 0:\n                self.scan = self.base + len(self.M); self._trim(len(self.M) - 400); return\n            m0 = lo + int(idx[0])                         # the window ends here\n            if m0 + 72 > len(self.M): self._trim(m0 - 120); return\n            seg = self.M[m0:m0 + 72]; pk = float(seg.max())\n            pl = np.nonzero(seg >= pk * 29 / 32)[0]; first, last = int(pl[0]), int(pl[-1])\n\
      \            n0 = m0 - 63                                  # the window starts here\n            s0 = n0 + ((first + last + 1) >> 1) - 8\n            start = s0 - self.back; end = start + FRAME\n            if start < 0:\n                self.scan = self.base + m0 + 72; continue\n            if end > len(self.x): self._trim(m0 - 120); return\n            cfo = float(np.angle(np.sum(self.S[m0 + first:m0 + last + 1])) / 32.0)\n            fr = self.x[start:end].copy(); rms = float(np.sqrt(np.mean(np.abs(fr[:240]) ** 2))) + 1e-20\n            self.queue.append((fr, cfo, 1.0 / rms)); self.frames += 1\n            self.scan = self.base + end; self._trim(end - 120)\n            self.skip_until = max(self.scan, self.scan + 86 + int(self.skip) * 3840 - 600)       # the next frame's S&C symbol is 86 samples after the end of this one; start 600 samples before the frame to be used\n\n    def general_work(self, input_items, output_items):\n        out = output_items[0]; produced = 0\n        n\
      \ = min(len(input_items[0]), len(input_items[1]), len(input_items[2]), 16384)\n        if n > 0 and len(self.queue) < 4:\n            if self.total + n <= self.skip_until:                                   # inside the frames that are skipped: nothing is kept\n                self.x = self.x[:0]; self.M = self.M[:0]; self.S = self.S[:0]; self.base = self.total + n; self.scan = self.base\n            else:\n                if len(self.x) == 0 and self.total < self.skip_until:                 # the chunk that ends the skipping: keep only its part after skip_until\n                    k = self.skip_until - self.total\n                    self.x = input_items[0][k:n].copy(); self.M = input_items[1][k:n].copy(); self.S = input_items[2][k:n].copy(); self.base = self.total + k; self.scan = self.base\n                else:\n                    self.x = np.concatenate([self.x, input_items[0][:n]]); self.M = np.concatenate([self.M, input_items[1][:n]]); self.S = np.concatenate([self.S, input_items[2][:n]])\n\
      \                self._search()\n            self.total += n; self.consume_each(n)\n        while produced < len(out):\n            if self.cur is None:\n                if not self.queue: break\n                self.cur, cfo, gain = self.queue.pop(0); self.pos = 0\n                off = self.nitems_written(0) + produced\n                self.add_item_tag(0, off, pmt.intern(\"cfo\"), pmt.from_double(cfo)); self.add_item_tag(0, off, pmt.intern(\"gain\"), pmt.from_double(gain))\n            k = min(len(out) - produced, len(self.cur) - self.pos)\n            out[produced:produced + k] = self.cur[self.pos:self.pos + k]; self.pos += k; produced += k\n            if self.pos == len(self.cur): self.cur = None\n        return produced\n"
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: 'S&C frame detector: the first window with M >= threshold starts a search over 72 windows; the middle of the plateau (the windows with M >= 29/32 of the largest) gives the start of the S&C symbol; the output is the frame of 47 symbols (3760 samples) with tags cfo (coarse carrier offset from arg S) and gain'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 24
    - 1300
    rotation: 0
    state: enabled
    _io_cache: ('S&C frame detector', 'blk', [('threshold', '0.65'), ('back', '6'), ('skip', '3')], [('0', 'complex', 1), ('1', 'float', 1), ('2', 'complex', 1)], [('0', 'complex', 1)], '', ['back', 'skip', 'threshold'])
  name: det
  id: epy_block
- parameters:
    back: '6'
    _source_code: "\"\"\"Coarse carrier correction and gain: every frame (3760 samples) is multiplied by gain * exp(-j cfo (i - back)), `cfo` and `gain` being the tags of the frame detector. The S&C estimate is unambiguous within +-60 kHz\n(the phase over the 32-sample delay stays within +-pi); what is left (a few hundred Hz) is measured from the two training symbols in the next block.\"\"\"\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFRAME = 3760\n\n\nclass blk(gr.sync_block):\n    def __init__(self, back=6):\n        gr.sync_block.__init__(self, name=\"Coarse CFO correction\", in_sig=[np.complex64], out_sig=[np.complex64])\n        self.back = back\n        self.i = (np.arange(FRAME) - back).astype(np.float32)\n        self.set_output_multiple(FRAME)\n\n    def work(self, input_items, output_items):\n        x, y = input_items[0], output_items[0]\n        nf = len(y) // FRAME\n        i = self.i\n        for f in range(nf):\n            a = f * FRAME; cfo, gain = 0.0, 1.0\n\
      \            for t in self.get_tags_in_window(0, a, a + 1):\n                k = pmt.symbol_to_string(t.key)\n                if k == \"cfo\": cfo = pmt.to_double(t.value)\n                elif k == \"gain\": gain = pmt.to_double(t.value)\n            ph = np.empty(FRAME, np.complex64); ang = np.float32(cfo) * i; ph.real = np.cos(ang); ph.imag = -np.sin(ang)\n            y[a:a + FRAME] = x[a:a + FRAME] * ph * np.float32(gain)\n        return nf * FRAME\n"
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: 'coarse carrier correction: x exp(-j cfo n) from the tag, and the gain (unit rms)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 400
    - 1300
    rotation: 0
    state: enabled
    _io_cache: ('Coarse CFO correction', 'blk', [('back', '6')], [('0', 'complex', 1)], [('0', 'complex', 1)], '', ['back'])
  name: coarse
  id: epy_block
- parameters:
    back: '6'
    check: 'True'
    _source_code: "\"\"\"Fine carrier correction and the check of the frame. The two training symbols T1 and T2 are the same 64 samples, 80 samples apart: P = sum T2 conj(T1), the remaining carrier offset is arg(P) / 80 rad/sample.\nThe frame is accepted when the two symbols really repeat: 2 |P|^2 >= E1 E2 (the normalised correlation is above 0.71); a false detection in noise is replaced by zeros (the later blocks skip it).\nOutputs: 1: the total carrier offset (coarse + fine) in Hz, 2: 1.0 for an accepted frame, 0.0 for a rejected one (one value per sample).\"\"\"\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFRAME = 3760; FS = 3.84e6\n\n\nclass blk(gr.sync_block):\n    def __init__(self, back=6, check=True):\n        gr.sync_block.__init__(self, name=\"Fine CFO correction and T1/T2 check\", in_sig=[np.complex64], out_sig=[np.complex64, np.float32, np.float32])\n        self.back, self.check = back, check\n        self.i = (np.arange(FRAME) - back).astype(np.float32)\n   \
      \     self.set_output_multiple(FRAME)\n        self.accepted = 0; self.rejected = 0\n\n    def work(self, input_items, output_items):\n        x, y, hz, okf = input_items[0], output_items[0], output_items[1], output_items[2]\n        nf = len(y) // FRAME\n        i = self.i\n        for f in range(nf):\n            a = f * FRAME; cfo = 0.0\n            for t in self.get_tags_in_window(0, a, a + 1):\n                if pmt.symbol_to_string(t.key) == \"cfo\": cfo = pmt.to_double(t.value)\n            fr = x[a:a + FRAME]\n            T1, T2 = fr[96:160], fr[176:240]                     # the FFT windows of symbols 1 and 2: 80 s + 16\n            P = np.sum(T2 * np.conj(T1)); E1 = float(np.sum(np.abs(T1) ** 2)); E2 = float(np.sum(np.abs(T2) ** 2))\n            ok = (2 * abs(P) ** 2 >= E1 * E2) or not self.check\n            wf = float(np.angle(P)) / 80.0\n            if ok:\n                ph = np.empty(FRAME, np.complex64); ang = np.float32(wf) * i; ph.real = np.cos(ang); ph.imag = -np.sin(ang)\n\
      \                y[a:a + FRAME] = fr * ph; self.accepted += 1\n            else:\n                y[a:a + FRAME] = 0; self.rejected += 1\n            hz[a:a + FRAME] = (cfo + wf) * FS / (2 * np.pi); okf[a:a + FRAME] = 1.0 if ok else 0.0\n        return nf * FRAME\n"
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: 'the two training symbols T1 and T2 are the same 64 samples 80 apart: arg(sum T2 conj T1) / 80 is the carrier offset that is left; they must also repeat (|P|^2 >= E1 E2 / 2), or the frame is a false detection and is replaced by zeros'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 640
    - 1300
    rotation: 0
    state: enabled
    _io_cache: ('Fine CFO correction and T1/T2 check', 'blk', [('back', '6'), ('check', 'True')], [('0', 'complex', 1)], [('0', 'complex', 1), ('1', 'float', 1), ('2', 'float', 1)], '', ['back', 'check'])
  name: fine
  id: epy_block
- parameters:
    vlen: '1'
    comment: '|frame|'
