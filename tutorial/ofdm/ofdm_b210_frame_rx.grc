- parameters:
    _source_code: "\"\"\"16-QAM slicer: the nearest of the levels -3 -1 +1 +3 (/ sqrt 10) on each axis, as the Gray code of the transmitter (levels -3 -1 +1 +3 = 00 01 11 10): the output byte is 4 * (I code) + (Q code), 0 .. 15.\nA value of exactly 0 (a rejected frame) gives 255.\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\nT = np.float32(2 / np.sqrt(10))              # decision thresholds -2, 0, +2 (/ sqrt 10)\nGRAY = np.array([0, 1, 3, 2], np.uint8)       # the level index 0 1 2 3 (-3 -1 +1 +3) -> the Gray code\n\n\nclass blk(gr.sync_block):\n    def __init__(self):\n        gr.sync_block.__init__(self, name=\"16-QAM slicer\", in_sig=[np.complex64], out_sig=[np.uint8])\n\n    def work(self, input_items, output_items):\n        z, o = input_items[0], output_items[0]\n        re, im = z.real, z.imag\n        ii = (re > -T).astype(np.uint8) + (re > 0) + (re > T); qq = (im > -T).astype(np.uint8) + (im > 0) + (im > T)\n        o[:] = GRAY[ii] * 4 + GRAY[qq]\n        o[z == 0] = 255\n\
      \        return len(o)\n"
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: '16-QAM slicer: nearest level on each axis, the Gray code of the transmitter, one byte (0 .. 15) per symbol'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 2360
    rotation: 0
    state: enabled
    _io_cache: ('16-QAM slicer', 'blk', [], [('0', 'complex', 1)], [('0', 'byte', 1)], '', [])
  name: slicer
  id: epy_block
- parameters:
    _source_code: "\"\"\"Symbol error counter. The payload of every frame is the PRBS-15 (x^15 + x^14 + 1, seed 0x7FFF, 4 bits per 16-QAM symbol, the first bit pair = I) restarted in every frame: 44 symbols x 24 subcarriers = 1056 values.\nEvery frame of 1056 slicer bytes is compared with it (a rejected frame, bytes of 255, is skipped). Outputs (one value per input byte): 0: symbol error rate since the start, 1: symbol errors, 2: frames decoded.\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\nNPAY = 1056\n\n\ndef prbs15_symbols(n):\n    s, bits = 0x7FFF, []\n    for _ in range(4 * n):\n        bits.append((s >> 14) & 1); s = ((s << 1) & 0x7FFF) | (((s >> 14) ^ (s >> 13)) & 1)\n    b = np.array(bits, int).reshape(n, 4)\n    return (b[:, 0] * 8 + b[:, 1] * 4 + b[:, 2] * 2 + b[:, 3]).astype(np.uint8)\n\n\nclass blk(gr.sync_block):\n    def __init__(self):\n        gr.sync_block.__init__(self, name=\"Symbol error counter\", in_sig=[np.uint8], out_sig=[np.float32, np.float32, np.float32])\n\
      \        self.ref = prbs15_symbols(NPAY)\n        self.sym = 0; self.err = 0; self.frames = 0\n        self.set_output_multiple(NPAY)\n\n    def work(self, input_items, output_items):\n        x = input_items[0]; nf = len(output_items[0]) // NPAY\n        for f in range(nf):\n            fr = x[f * NPAY:(f + 1) * NPAY]\n            if not np.any(fr == 255):\n                self.err += int(np.count_nonzero(fr != self.ref)); self.sym += NPAY; self.frames += 1\n            sl = slice(f * NPAY, (f + 1) * NPAY)\n            output_items[0][sl] = self.err / self.sym if self.sym else 0.0; output_items[1][sl] = self.err; output_items[2][sl] = self.frames\n        return nf * NPAY\n"
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: 'compares every frame with the PRBS-15 payload that the transmitter sends: symbol errors since the start, symbol error rate, frames decoded'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 2520
    rotation: 0
    state: enabled
    _io_cache: ('Symbol error counter', 'blk', [], [('0', 'byte', 1)], [('0', 'float', 1), ('1', 'float', 1), ('2', 'float', 1)], '', [])
  name: counter
  id: epy_block
