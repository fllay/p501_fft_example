  id: fft_vxx
- parameters:
    sync_symbol1: sync_word
    sync_symbol2: sync_word
    n_data_symbols: '1'
    eq_noise_red_len: '0'
    max_carr_offset: '-1'
    force_one_symbol: 'True'
    comment: 'STOCK BLOCK: channel estimate H[k] = received / known from the first header symbol (one training symbol: force one sync symbol; the sync word is given twice because the block uses the second one to find the active subcarriers); the second header symbol passes with H as a tag'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1240
    - 1500
    rotation: 0
    state: enabled
  name: chanest
  id: digital_ofdm_chanest_vcvc
- parameters:
    nsym: '44'
    _source_code: "\"\"\"Header stand-in. The stock receiver chain expects a header with the length of the packet after the synchronisation symbols; this frame has none: it always has 44 data symbols after S&C, T1 and T2.\nInput: the third symbol of every frame (T2) after the FFT and the channel estimator, 64 values, with the tags of the channel estimator. For every frame it sends the message that the Header/Payload Demux waits for:\nframe_length = nsym data symbols, and the channel estimate and the carrier offset of the tags (the equalizer of the payload needs them). Output: the channel estimate H[k] of the frame (64 values, DC in the middle, zero on the unused subcarriers) for the plots.\"\"\"\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self, nsym=44):\n        gr.sync_block.__init__(self, name=\"Header stand-in (fixed frame length)\", in_sig=[(np.complex64, 64)], out_sig=[(np.complex64, 64)])\n        self.nsym = nsym\n   \
      \     self.frames = 0\n        self.message_port_register_out(pmt.intern(\"header_data\"))\n\n    def work(self, input_items, output_items):\n        n0 = self.nitems_read(0); n = len(input_items[0]); out = output_items[0]\n        out[:] = 0\n        for i in range(n):\n            d = pmt.make_dict()\n            d = pmt.dict_add(d, pmt.intern(\"frame_length\"), pmt.from_long(int(self.nsym)))\n            for t in self.get_tags_in_range(0, n0 + i, n0 + i + 1):\n                d = pmt.dict_add(d, t.key, t.value)\n                if pmt.symbol_to_string(t.key) == \"ofdm_sync_chan_taps\":\n                    out[i] = np.array(pmt.c32vector_elements(t.value), dtype=np.complex64)\n            self.message_port_pub(pmt.intern(\"header_data\"), d)\n            self.frames += 1\n        return n\n"
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: 'the stand-in for the packet header (the frame has none: always 44 data symbols): sends the message the Header/Payload Demux waits for, with the channel estimate of the tag, and outputs the estimate for the plots'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1480
    - 1500
    rotation: 0
    state: enabled
    _io_cache: ('Header stand-in (fixed frame length)', 'blk', [('nsym', '44')], [('0', 'complex', 64)], [('0', 'complex', 64), ('header_data', 'message', 1)], '', ['nsym'])
  name: hdr
  id: epy_block
