    bus_structure: null
    coordinate:
    - 560
    - 760
    rotation: 0
    state: enabled
  name: rx_in
  id: blocks_copy
- parameters:
    type: complex
    alpha: 1e-4
    vlen: '1'
    comment: 'the DC offset (the local oscillator leakage of the B210, the spike at 0 Hz of the spectrum) as a very slow low-pass: the time constant is 10000 samples'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
